import QtQuick
import QtQuick.Controls
import QtQuick.Layouts

Rectangle {
    id: root
    width: 40

    property var stateManager

    property var stepsModel: ["Step 1: Select Files", "Step 2: Run Process", "Step 3: 3D Reconstruction"]

    ColumnLayout {
        id: colLayout

        anchors.fill: parent
        anchors.margins: 10
        spacing: 5

        Repeater {
            model: root.stepsModel

            delegate: Button {
                id: stepButton
                required property int index
                required property string modelData
                text: modelData
                Layout.fillWidth: true
                Layout.preferredHeight: 100

                //enabled: index == 0 || stateManager.completedSteps.includes(
                //             index - 1)
                highlighted: stateManager.currentStep === index

                Connections {
                    target: stepButton
                    function onClicked() {
                        stateManager.navigateTo(index)
                    }

                    Component.onCompleted: {
                        console.log("Creating button index:", index,
                                    "with data:", JSON.stringify(modelData))
                    }
                }
            }
        }

        Item {
            Layout.fillHeight: true
        }
    }
}
